# DreamArt Events - Render Persistent Disk Environment Variables
NODE_ENV=production
PORT=3000

# Required Admin Authentication Secrets
# Production will fail fast if either variable is missing
ADMIN_PASSWORD=
SESSION_SECRET=

# Render Persistent Disk Mount Point
# On Render: Attach a Persistent Disk with Mount Path set to /var/data
# Development defaults to ./data-dev if PERSISTENT_DATA_DIR is unset
PERSISTENT_DATA_DIR=/var/data

# Optional application variables
DISABLE_HMR=true
