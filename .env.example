# Application environment variables
GEMINI_API_KEY=
DISABLE_HMR=
ADMIN_PASSWORD=
SESSION_SECRET=

# Google Cloud Storage & Firestore Configuration (Required for Production)
# GCS Bucket name (e.g., dreamart-events-media)
GCS_BUCKET_NAME=
# Google Cloud Project ID (e.g., dreamart-events-prod)
GOOGLE_CLOUD_PROJECT=
# Optional Firestore collection name (defaults to dreamart_images)
FIRESTORE_COLLECTION=dreamart_images
